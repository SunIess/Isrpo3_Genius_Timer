{
  "name": "focus-timer",
  "displayName": "Focus Timer",
  "description": "Таймер продуктивности",
  "version": "1.0.0",
  "engines": { "vscode": "^1.80.0" },
  "activationEvents": [
    "onCommand:focusTimer.start",
    "onCommand:focusTimer.stop",
    "onCommand:focusTimer.showStats"
  ],
  "main": "./code.js",
  "contributes": {
    "commands": [
      {
        "command": "focusTimer.start",
        "title": "Focus Timer: Запустить таймер"
      },
      {
        "command": "focusTimer.stop",
        "title": "Focus Timer: Остановить таймер"
      },
      {
        "command": "focusTimer.showStats",
        "title": "Focus Timer: Показать статистику"
      }
    ],
    "configuration": {
      "title": "Focus Timer",
      "properties": {
        "focusTimer.sessionMinutes": {
          "type": "number",
          "default": 25,
          "description": "Длительность одной сессии (в минутах)"
        },
        "focusTimer.breakMinutes": {
          "type": "number",
          "default": 5,
          "description": "Длительность перерыва (в минутах)"
        },
        "focusTimer.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Показывать уведомление со звуком (эмодзи) по окончании"
        },
        "focusTimer.autoStartNext": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически запускать следующую сессию или перерыв"
        }
      }
    }
  }
}